#!/bin/bash
# Runs the arbiter package in lib/ on Python 3.11 or later, or through uv.
#
# `arbiter hook` never blocks a session over a missing interpreter: it lets the
# turn end, and says so when the repository or user has an arbiter config.
#
# Hooks inherit Claude Code's PATH, which is minimal when it was started from a
# GUI, so the usual install locations are searched after it. ARBITER_PYTHON
# names an interpreter outright; ARBITER_FALLBACK_PATH replaces the extra
# locations, for tests.

boot='import sys; sys.path.insert(0, sys.argv.pop(1)); from arbiter.cli import main; sys.exit(main())'

if [ "${1:-}" = hook ] && [ -n "${ARBITER_CHILD:-}" ]; then
    [ -t 0 ] || cat >/dev/null
    echo '{}'
    exit 0
fi

src=${BASH_SOURCE[0]}
while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case $src in /*) ;; *) src=$dir/$src ;; esac
done
lib=$(cd -P "$(dirname "$src")/../lib" && pwd)

fallback=${ARBITER_FALLBACK_PATH-/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:$HOME/.local/bin}

usable() {
    "$1" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1
}

search() {
    local dir name IFS=:
    set -f
    for dir in $PATH:$fallback; do
        [ -n "$dir" ] || continue
        for name in "$@"; do
            if [ -x "$dir/$name" ] && { [ "$name" = uv ] || usable "$dir/$name"; }; then
                set +f
                printf '%s' "$dir/$name"
                return 0
            fi
        done
    done
    set +f
    return 1
}

if [ -n "${ARBITER_PYTHON:-}" ]; then
    usable "$ARBITER_PYTHON" && exec "$ARBITER_PYTHON" -I -c "$boot" "$lib" "$@"
elif python=$(search python3.14 python3.13 python3.12 python3.11 python3); then
    exec "$python" -I -c "$boot" "$lib" "$@"
elif uv=$(search uv); then
    exec "$uv" run --quiet --no-project --no-config --python '>=3.11' -- python -I -c "$boot" "$lib" "$@"
fi

configured() {
    local root config=${XDG_CONFIG_HOME:-$HOME/.config}/arbiter/defaults.toml
    [ -f "$config" ] && return 0
    root=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
    [ -n "$root" ] && { [ -f "$root/arbiter.toml" ] || [ -f "$root/arbiter.local.toml" ]; }
}

if [ "${1:-}" = hook ]; then
    [ -t 0 ] || cat >/dev/null
    if configured; then
        echo '{"systemMessage": "arbiter: needs Python 3.11 or later, or uv; this turn was not gated"}'
    else
        echo '{}'
    fi
    exit 0
fi
echo "arbiter: needs Python 3.11 or later, or uv" >&2
exit 1
